---
interface Props {
  text: string;
  origin: string;
}

const { text, origin } = Astro.props;
---

<div data-knockout class="pointer-events-none grid [grid-area:1/1]">
  <div
    class="bg-text grid place-items-center [mix-blend-mode:darken] [grid-area:1/1]"
  >
    <p
      data-mask
      style={`transform-origin: ${origin}`}
      class="text-background scale-[400] text-[80px] leading-[1.05] font-[800] tracking-[-0.015em] [will-change:opacity] [text-rendering:geometricPrecision]"
    >
      {text}
    </p>
  </div>

  <div
    data-floor
    class="bg-text opacity-0 [mix-blend-mode:lighten] [grid-area:1/1]"
  >
  </div>
</div>
