---
import Pause from "@/shared/components/dotnav/ui/pause.svg";
import Play from "@/shared/components/dotnav/ui/play.svg";

const material =
  "bg-[color-mix(in_srgb,color-mix(in_srgb,var(--color-secondary)_35%,var(--color-primary))_70%,transparent)] backdrop-blur-[6.25px] [-webkit-backdrop-filter:blur(6.25px)]";
---

<div
  data-dotnav
  class="pointer-events-auto mb-[100px] will-change-transform [&[data-inactive]]:pointer-events-none [&[data-inactive]]:opacity-0"
>
  <div
    data-lift
    class="relative isolate flex items-center will-change-transform"
  >
    <div
      data-bubble
      class={`${material} relative flex h-[50px] items-center rounded-[25px] px-[20px]`}
    >
      <div data-dots class="flex items-center gap-[15px]"></div>
    </div>

    <div
      data-bubble
      class={`${material} absolute top-0 left-0 h-[50px] w-[50px] rounded-[25px]`}
    >
      <button
        data-toggle
        type="button"
        aria-label="Toggle autoplay"
        class="text-text/50 hover:bg-text/5 hover:text-text grid h-full w-full cursor-pointer place-items-center rounded-[25px] transition-[color,background-color] duration-[250ms]"
      >
        <span data-icons class="grid place-items-center">
          <Pause
            aria-hidden="true"
            class="hidden w-[20px] [[data-state=playing]_&]:block"
          />
          <Play
            aria-hidden="true"
            class="hidden w-[20px] [[data-state=ended]_&]:block [[data-state=paused]_&]:block"
          />
        </span>
      </button>
    </div>

    <template data-blueprint>
      <button
        type="button"
        class="bg-text/50 [&:hover:not([data-active])]:bg-text relative h-[7.5px] w-[7.5px] min-w-[7.5px] cursor-pointer overflow-hidden rounded-[5px] [transition:min-width_400ms_cubic-bezier(0.33,0,0.67,1),background-color_250ms_linear] before:absolute before:-inset-[7.5px] before:content-[''] [&[data-active]]:pointer-events-none [&[data-active]]:min-w-[45px] [&[data-active]]:cursor-default"
      >
        <span
          class="bg-text absolute top-0 left-0 -ml-[15%] hidden h-full w-0 min-w-[15%] rounded-[5px] [[data-active]_&]:block [[data-active]_&]:[animation:dwell_var(--dwell)_linear_forwards] [[data-beat=paused]_[data-active]_&]:[animation-play-state:paused]"
        ></span>
      </button>
    </template>
  </div>
</div>

<script>
  import { dotnav } from "@/shared/components/dotnav/model/timeline";

  const navs = document.querySelectorAll<HTMLElement>("[data-dotnav]");
  navs.forEach((nav) => dotnav(nav));
</script>
