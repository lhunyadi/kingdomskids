---
const headline = Astro.slots.has("headline");
---

<div
  data-carousel
  class="[container-type:inline-size] [&_li]:min-h-[680px] [&_li]:w-[87.5cqw] [&_li]:max-w-[1260px] [&_li]:cursor-pointer [&_li]:[scroll-snap-align:center] [&_li]:select-none"
>
  {
    headline && (
      <div class="px-[max(6.25cqw,calc((100cqw_-_1260px)/2))] pb-[40px]">
        <slot name="headline" />
      </div>
    )
  }

  <div class="relative pb-[250px]">
    <div
      data-track
      role="group"
      aria-label="Slides"
      tabindex="-1"
      class="-mb-[25px] [scroll-snap-type:x_mandatory] [scrollbar-width:none] overflow-x-scroll overflow-y-hidden pb-[25px]"
    >
      <ul
        role="list"
        class="mx-auto grid w-fit grid-flow-col gap-[20px] px-[max(6.25cqw,calc((100cqw_-_1260px)/2))]"
      >
        <slot />
      </ul>
    </div>

    <div
      data-control
      class="pointer-events-none absolute inset-x-0 top-[70px] bottom-0 flex items-end justify-center overflow-clip"
    >
      <slot name="control" />
    </div>
  </div>
</div>

<script>
  import { carousel } from "@/shared/components/carousel/model/timeline";

  const roots = document.querySelectorAll<HTMLElement>("[data-carousel]");
  roots.forEach((root) => carousel(root));
</script>
