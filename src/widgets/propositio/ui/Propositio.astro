---
import Drawing from "@/widgets/propositio/ui/jesus.svg";
---

<section data-propositio class="bg-background [container-type:inline-size]">
  <div data-pin data-lock class="relative grid place-items-center">
    <Drawing
      data-drawing
      aria-hidden="true"
      class="text-secondary pointer-events-none w-[87.5cqw] max-w-[1260px] [grid-area:1/1]"
    />

    <figure class="relative w-[87.5cqw] max-w-[1260px] [grid-area:1/1]">
      <blockquote
        cite="https://www.biblegateway.com/passage/?search=Matthew%2028%3A19"
      >
        <p
          data-line
          class="text-[50px] leading-tight font-semibold tracking-[-0.005em]"
        >
          <span data-exordium class="inline-block"
            ><span class="text-accent">Jesus</span> said</span
          ><span data-passage
            >: "Therefore go and make <span class="text-accent">disciples</span
            >{" "}
            of all <span class="text-accent">nations</span>, baptizing them in
            the name of the Father and of the Son and of the Holy Spirit."</span
          >
        </p>
      </blockquote>
      <figcaption class="mt-[40px] overflow-hidden">
        <cite
          data-reference
          class="block text-[15px] font-[15] tracking-widest not-italic"
          >MATTHEW 28:19</cite
        >
      </figcaption>
    </figure>
  </div>
</section>

<script>
  import { propositio } from "@/widgets/propositio/model/timeline";

  const root = document.querySelector<HTMLElement>("[data-propositio]");
  if (root) propositio(root);
</script>
