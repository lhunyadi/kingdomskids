---
import Propositio from "@/widgets/propositio/ui/Propositio.astro";
import Confirmatio from "@/widgets/confirmatio/ui/Confirmatio.astro";
import Refutatio from "@/widgets/refutatio/ui/Refutatio.astro";
---

<main class="grid [&>*]:pt-[150px] [&>*]:pb-[200px]">
  <Propositio />

  <div
    class="grid gap-[120px] bg-[linear-gradient(to_bottom,var(--color-background),var(--color-primary)_150px)]"
  >
    <Confirmatio />
    <Refutatio />
  </div>
</main>
